        {
          "type": "curl",
          "snippet": "curl -X GET '{{gatewayUrl}}/consultas-externas-api/api/v1/dossie/tiposProduto' \\\n  -H 'Accept: application/json' \\\n  -H 'Authorization: Bearer <token>'"
        }
      ]
    },
    {
      "id": "acoesFiscalizacao",
      "path": "/dossie/acoesFiscalizacao",
