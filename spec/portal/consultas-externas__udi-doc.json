    {
      "id": "paginar",
      "path": "/api/v1/udi",
      "method": "POST",
      "description": "Retorna UDI paginados. Recebe JSON com column, count, order, page e filtros em filter[...]. Use os filtros específicos como categoriaDispositivo, cnpjDetentora, codigoGmdn etc.",
      "filters": [
        {
          "name": "count",
          "type": "string",
          "description": "Quantidade de itens por página.",
          "example": "10"
        },
        {
          "name": "page",
          "type": "integer (int32)",
          "description": "Número da página.",
          "example": "1"
        },
        {
          "name": "filter.categoriaDispositivo",
          "type": "string",
          "description": "Categoria do dispositivo.",
          "example": "EQUIPAMENTO"
        },
        {
          "name": "filter.cnpjDetentora",
          "type": "string",
          "description": "CNPJ da empresa detentora.",
          "example": "11195731000156"
        },
        {
          "name": "filter.codigoGmdn",
          "type": "string",
          "description": "Código do termo GMDN (campo codigo de POST /api/v1/udi/termoGmdn).",
          "example": "30259"
        },
        {
          "name": "filter.incorpora",
          "type": "string",
          "description": "Indicador S ou N.",
          "example": "S"
        },
        {
          "name": "filter.nomeComercial",
          "type": "string",
          "description": "Nome comercial.",
          "example": "a"
        },
        {
          "name": "filter.nuRegistro",
          "type": "string",
          "description": "Número do registro.",
          "example": "80290080001"
        },
        {
          "name": "filter.razaoSocialFabLegal",
          "type": "string",
          "description": "Razão social do fabricante legal.",
          "example": "as"
        },
        {
          "name": "filter.tipoCadastro",
          "type": "string",
          "description": "Tipo de cadastro.",
          "example": "RECONDICIONADO"
        },
        {
          "name": "filter.udiDi",
          "type": "string",
          "description": "Identificador UDI-DI.",
          "example": "a"
        },
        {
          "name": "filter.usoLeigo",
          "type": "string",
          "description": "Uso leigo: S ou N.",
          "example": "S"
        },
        {
          "name": "filter.versaoModelo",
          "type": "string",
          "description": "Versão ou modelo.",
          "example": "a"
        }
      ],
      "examples": [
        {
          "type": "curl",
          "snippet": "curl -X POST '{{gatewayUrl}}/consultas-externas-api/api/v1/udi' \\\n  -H 'Accept: application/json' \\\n  -H 'Authorization: Bearer <token>' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\n    \"count\": \"10\",\n    \"page\": \"1\",\n    \"filter\": {\n      \"categoriaDispositivo\": \"EQUIPAMENTO\",\n      \"cnpjDetentora\": \"11195731000156\",\n      \"codigoGmdn\": \"30259\",\n      \"incorpora\": \"S\",\n      \"nomeComercial\": \"a\",\n      \"nuRegistro\": \"80290080001\",\n      \"razaoSocialFabLegal\": \"as\",\n      \"tipoCadastro\": \"RECONDICIONADO\",\n      \"udiDi\": \"a\",\n      \"usoLeigo\": \"S\",\n      \"versaoModelo\": \"a\"\n    }\n  }'"
        },
        {
          "type": "http",
          "snippet": "POST {{gatewayUrl}}/consultas-externas-api/api/v1/udi HTTP/1.1\nHost: {{gatewayHost}}\nAccept: application/json\nAuthorization: Bearer <token>\nContent-Type: application/json\n\n{\n  \"count\": \"10\",\n  \"page\": \"1\",\n  \"filter\": {\n    \"categoriaDispositivo\": \"EQUIPAMENTO\",\n    \"cnpjDetentora\": \"11195731000156\",\n    \"codigoGmdn\": \"30259\",\n    \"incorpora\": \"S\",\n    \"nomeComercial\": \"a\",\n    \"nuRegistro\": \"80290080001\",\n    \"razaoSocialFabLegal\": \"as\",\n    \"tipoCadastro\": \"RECONDICIONADO\",\n    \"udiDi\": \"a\",\n    \"usoLeigo\": \"S\",\n    \"versaoModelo\": \"a\"\n  }\n}"
