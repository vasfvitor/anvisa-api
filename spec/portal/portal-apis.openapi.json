{
  "openapi": "3.0.1",
  "info": {
    "title": "portal-anvisa-backend",
    "description": "Feito com Arquitetura Spring Boot da Anvisa",
    "contact": {
      "name": "Contato",
      "email": "arquitetura@anvisa.gov.br"
    },
    "version": "1.3.0"
  },
  "servers": [
